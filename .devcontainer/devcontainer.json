{
    "name": "Buck2-Reindeer Demo",
    "build": {
        "dockerfile": "./Dockerfile",
        "args": {
            "USERNAME": "rust", // Used for creating "/home/$USERNAME" directory within container
            "USER_UID": "1000"
        }
    },
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "mounts": [
        // Uncomment the following line to mount local prelude into dev container
        // "source=/path/to/local/prelude,target=/workspace/prelude,type=bind"
    ],
    "remoteUser": "rust",
    "customizations": {
        "vscode": {
            "extensions": [
                "bazelbuild.vscode-bazel",
                "rust-lang.rust-analyzer@prerelease",
                "tamasfe.even-better-toml"
            ]
        }
    },
    // Start NativeLink after dev container starts
    "postStartCommand": "nativelink /workspace/.devcontainer/nativelink_config.json5"
}